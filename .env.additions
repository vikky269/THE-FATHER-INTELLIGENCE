# ============================================================ AUTOMATION
# Append these to .env.local AND to Netlify's environment variables.

# --- OpenAI Platform (NOT the ChatGPT subscription — separate billing) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- Auth for /api/generate. Generate with: openssl rand -hex 32 ---
GENERATE_API_TOKEN=

# --- Market data ---------------------------------------------------------
# FRED: free. https://fredaccount.stlouisfed.org/apikeys
# Covers US2Y, US10Y, dollar index, Brent, WTI. END-OF-DAY, lags ~1 day.
FRED_API_KEY=

# Twelve Data: paid tier. https://twelvedata.com/pricing
# Covers gold, silver, FX, S&P, Nasdaq, Dow, VIX. Live.
TWELVE_DATA_API_KEY=

# CoinGecko needs no key (BTC, ETH).

# --- Used by the scheduled functions to call back into the site ---------
SITE_URL=https://thefatherintelligence.com
